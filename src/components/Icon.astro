---
type IconName = "code" | "web" | "palette" | "sparkles" | "cpu" | "shield" | "flask" | "graduation" | "search" | "trophy" | "book" | "menu" | "close" | "clock" | "chevron" | "robot" | "external" | "check" | "play" | "binary";
interface Props { name: IconName; size?: number; }
const { name, size = 24 } = Astro.props;
---
<svg xmlns="http://www.w3.org/2000/svg" width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
  {name === "code" && <><path d="m8 8-4 4 4 4M16 8l4 4-4 4M14 5l-4 14" /></>}
  {name === "web" && <><rect x="3" y="4" width="18" height="14" rx="2" /><path d="M3 8h18M7 6h.01M10 6h.01M8 22h8M12 18v4" /></>}
  {name === "palette" && <><path d="M12 3a9 9 0 1 0 0 18h1.5a2.5 2.5 0 0 0 1.7-4.3 1.5 1.5 0 0 1 1.1-2.6H18a3 3 0 0 0 3-3c0-4.5-4-8.1-9-8.1Z" /><circle cx="7.5" cy="11" r=".8" /><circle cx="10" cy="7.5" r=".8" /><circle cx="15" cy="8" r=".8" /></>}
  {name === "sparkles" && <><path d="m12 3 1.5 6L20 11l-6.5 1.8L12 19l-1.5-6.2L4 11l6.5-2L12 3Z" /><path d="m19 16 .6 2.2L22 19l-2.4.7L19 22l-.6-2.3L16 19l2.4-.8L19 16ZM5 2l.6 2.4L8 5l-2.4.7L5 8l-.6-2.3L2 5l2.4-.7L5 2Z" /></>}
  {name === "cpu" && <><rect x="6" y="6" width="12" height="12" rx="2" /><path d="M9 9h6v6H9zM9 2v4M15 2v4M9 18v4M15 18v4M2 9h4M2 15h4M18 9h4M18 15h4" /></>}
  {name === "shield" && <><path d="M12 22s8-4 8-11V5l-8-3-8 3v6c0 7 8 11 8 11Z" /><path d="m9 12 2 2 4-4" /></>}
  {name === "flask" && <><path d="M9 3h6M10 3v6l-5.7 9.2A2.5 2.5 0 0 0 6.4 22h11.2a2.5 2.5 0 0 0 2.1-3.8L14 9V3M8 15h8" /></>}
  {name === "graduation" && <><path d="m2 10 10-6 10 6-10 6-10-6Z" /><path d="M6 12v5c3.5 3 8.5 3 12 0v-5M22 10v6" /></>}
  {name === "search" && <><circle cx="10.8" cy="10.8" r="6.8" /><path d="m16 16 5 5" /></>}
  {name === "trophy" && <><path d="M8 21h8M12 17v4M7 4h10v5a5 5 0 0 1-10 0V4ZM7 6H4v2a4 4 0 0 0 4 4M17 6h3v2a4 4 0 0 1-4 4" /></>}
  {name === "book" && <><path d="M4 5.5A2.5 2.5 0 0 1 6.5 3H20v17H6.5A2.5 2.5 0 0 1 4 17.5v-12Z" /><path d="M4 17.5A2.5 2.5 0 0 1 6.5 15H20M8 7h8M8 10h6" /></>}
  {name === "menu" && <><path d="M4 6h16M4 12h16M4 18h16" /></>}
  {name === "close" && <><path d="m6 6 12 12M18 6 6 18" /></>}
  {name === "clock" && <><circle cx="12" cy="12" r="9" /><path d="M12 7v5l3 2" /></>}
  {name === "chevron" && <><path d="m9 18 6-6-6-6" /></>}
  {name === "robot" && <><rect x="4" y="7" width="16" height="13" rx="3" /><path d="M12 3v4M8 12h.01M16 12h.01M9 16h6M2 12h2M20 12h2" /></>}
  {name === "external" && <><path d="M14 3h7v7M10 14 21 3" /><path d="M19 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V7a2 2 0 0 1 2-2h6" /></>}
  {name === "check" && <><path d="m5 12 4 4L19 6" /></>}
  {name === "play" && <><path d="m8 5 12 7-12 7V5Z" /></>}
  {name === "binary" && <><rect x="3" y="4" width="18" height="16" rx="2" /><path d="M8 9h.01M8 15h.01M12 9h.01M12 15h.01M16 9h.01M16 15h.01" /></>}
</svg>
