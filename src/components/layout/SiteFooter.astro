  <div class="wrap footer-main">
    <div class="footer-brand-block">
      <a class="brand footer-brand" href={withBase("/")} aria-label="ITWorkshop – úvodní stránka"><img src={withBase("/brand/logo.svg")} alt="ITWorkshop" width="220" height="27" loading="lazy" /></a>
      <p>Vzdělávací projekt pro mladé zájemce o informační technologie. Objevuj, zkoušej a tvoř vlastním tempem.</p>
    </div>
    <div class="footer-links"><h2>Objevuj</h2><a href={withBase("/temata/")}>Témata</a><a href={withBase("/materialy/")}>Všechny materiály</a><a href={withBase("/kurzy/")}>Kurzy</a><a href={withBase("/clanky/")}>Články</a><a href={withBase("/navody/")}>Návody</a></div>
    <div class="footer-links"><h2>Vyzkoušej</h2><a href={withBase("/kvizy/")}>Kvízy</a><a href={withBase("/vyzvy/")}>Výzvy</a><a href={withBase("/laborator/")}>Laboratoř</a><a href={withBase("/workshopy/")}>Workshopy</a></div>
