---
interface Props { id: string; eyebrow?: string; title: string; description?: string; linkHref?: string; linkLabel?: string; }
const { id, eyebrow, title, description, linkHref, linkLabel } = Astro.props;
---
<div class="section-heading">
  <div>
    {eyebrow && <p class="eyebrow">{eyebrow}</p>}
    <h2 id={id}>{title}</h2>
    {description && <p class="section-description">{description}</p>}
  </div>
  {linkHref && linkLabel && <a class="text-link section-link" href={linkHref}>{linkLabel}<span class="sr-only">: {title}</span></a>}
</div>
