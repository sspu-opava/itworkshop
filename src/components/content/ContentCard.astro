---
import Icon from "../Icon.astro";
import { withBase } from "../../lib/paths";
import type { CardItem } from "../../lib/content";
interface Props { item: CardItem; compact?: boolean; }
const { item, compact = false } = Astro.props;
const pattern = item.topic.replaceAll(/[^a-z0-9-]/gi, "");
---
<article class:list={["content-card", compact && "content-card-compact"]} data-card data-topic={item.topic} data-difficulty={item.difficultyId} data-type={item.typeId} data-duration={item.duration}>
  <div class:list={["card-art", `art-${pattern}`, item.cover && "has-cover"]} aria-hidden="true">
    {item.cover ? <img src={withBase(item.cover)} alt="" width="1376" height="768" loading="lazy" /> : <>
      <span class="art-grid"></span>
      <span class="art-icon"><Icon name={item.icon} size={40} /></span>
      <span class="art-mark">{item.topic === "ai" ? "AI" : item.topic === "grafika" ? "RGB" : item.topic === "web" ? "HTML" : item.topic === "hardware" ? "0101" : item.topic === "bezpecnost" ? "SAFE" : "PY"}</span>
    </>}
  </div>
  <div class="content-card-body">
    <div class="card-meta"><span class="content-type" data-pagefind-filter="Typ">{item.type}</span><span class="difficulty-label" data-pagefind-filter="Obtížnost">{item.difficulty}</span><span class="sr-only" data-pagefind-filter="Téma">{item.topicLabel}</span></div>
    <h3><a href={withBase(item.href)}>{item.title}</a></h3>
    <p>{item.description}</p>
    <div class="card-bottom"><span><Icon name="clock" size={16} /> {item.duration} min · {item.age}+</span><a href={withBase(item.href)} class="card-action">Otevřít {item.type.toLocaleLowerCase("cs-CZ")}</a></div>
  </div>
</article>
