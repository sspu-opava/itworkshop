---
import { withBase } from "../../lib/paths";
interface LinkItem {
  href: string;
  label: string;
  download?: boolean;
  newTab?: boolean;
}

interface Props {
  path?: string | undefined;
  title: string;
  description: string;
  sourceLabel?: string;
  additionalLinks?: LinkItem[];
}

const { path, title, description, sourceLabel = "Stáhnout zdroj LiaScript", additionalLinks = [] } = Astro.props;
const sourceUrl = path && Astro.site ? new URL(withBase(path), Astro.site).href : undefined;
const launchUrl = sourceUrl ? `https://liascript.github.io/course/?${sourceUrl}` : undefined;
---

<section class="course-launch" aria-labelledby="interactive-launch-title">
  <h2 id="interactive-launch-title">{title}</h2>
  <p>{description}</p>
  <div class="button-row">
    {launchUrl && <a class="button button-primary" href={launchUrl} target="_blank" rel="noopener noreferrer">Otevřít v LiaScriptu <span class="sr-only">(nová karta)</span></a>}
    {path && <a class="button button-secondary" href={withBase(path)} download>{sourceLabel}</a>}
    {additionalLinks.map((link) => <a class="text-link" href={withBase(link.href)} download={link.download || undefined} target={link.newTab ? "_blank" : undefined} rel={link.newTab ? "noopener noreferrer" : undefined}>{link.label}{link.newTab && <span class="sr-only"> (nová karta)</span>}</a>)}
  </div>
</section>
