---
import Icon from "../Icon.astro";
const channels = [
  { id: "red", label: "Červená", value: 6, color: "#d53b4a" },
  { id: "green", label: "Zelená", value: 75, color: "#16845b" },
  { id: "blue", label: "Modrá", value: 219, color: "#1758c5" },
];
---
<section class="lab-panel rgb-lab" data-rgb-lab aria-labelledby="rgb-lab-title">
  <header class="lab-heading"><span class="lab-icon"><Icon name="palette" size={22} /></span><div><p class="eyebrow">Experiment</p><h2 id="rgb-lab-title">Míchej světlo v RGB</h2></div></header>
  <p>Displej skládá barvy z červené, zelené a modré složky. Každá má hodnotu od 0 do 255.</p>
  <div class="rgb-controls">
    {channels.map((channel) => <label class="rgb-channel" for={`rgb-${channel.id}`}><span class="rgb-label"><span class="channel-dot" style={`--channel-color:${channel.color}`}></span>{channel.label}</span><input id={`rgb-${channel.id}`} type="range" min="0" max="255" value={channel.value} data-channel={channel.id} aria-valuetext={`${channel.label} ${channel.value}`} /><output data-channel-output={channel.id}>{channel.value}</output></label>)}
  </div>
  <div class="rgb-result"><div class="color-swatch" data-color-swatch role="img" aria-label="Vzorek právě namíchané barvy"></div><div class="rgb-readout"><span>HEX</span><strong data-hex-color>#064BDB</strong><span data-rgb-color>RGB (6, 75, 219)</span><button class="button button-secondary" type="button" data-copy-hex>Kopírovat HEX</button><p class="copy-status" data-copy-status role="status" aria-live="polite"></p></div></div>
  <div class="preset-row"><span>Ukázky:</span><button class="preset-chip" type="button" data-rgb-preset="255,0,0">Červená</button><button class="preset-chip" type="button" data-rgb-preset="255,255,0">Žlutá</button><button class="preset-chip" type="button" data-rgb-preset="0,204,255">Tyrkysová</button><button class="preset-chip" type="button" data-rgb-preset="128,128,128">Šedá</button></div>
</section>

<script>
  document.querySelectorAll<HTMLElement>("[data-rgb-lab]").forEach((root) => {
    const inputs = Array.from(root.querySelectorAll<HTMLInputElement>("[data-channel]"));
    const swatch = root.querySelector<HTMLElement>("[data-color-swatch]");
    const hexOutput = root.querySelector<HTMLElement>("[data-hex-color]");
    const rgbOutput = root.querySelector<HTMLElement>("[data-rgb-color]");
    const status = root.querySelector<HTMLElement>("[data-copy-status]");
    const readValues = () => inputs.map((input) => Math.min(255, Math.max(0, Number(input.value))));
    const toHex = (value: number) => value.toString(16).padStart(2, "0").toUpperCase();
    const draw = () => {
      const values = readValues();
      const hex = `#${values.map(toHex).join("")}`;
      if (swatch) swatch.style.backgroundColor = hex;
      if (hexOutput) hexOutput.textContent = hex;
      if (rgbOutput) rgbOutput.textContent = `RGB (${values.join(", ")})`;
      inputs.forEach((input, index) => {
        const output = root.querySelector<HTMLOutputElement>(`[data-channel-output="${input.dataset.channel}"]`);
        if (output) output.value = String(values[index] ?? 0);
        input.setAttribute("aria-valuetext", `${input.dataset.channel}: ${values[index] ?? 0} z 255`);
      });
      if (status) status.textContent = "";
    };
    inputs.forEach((input) => input.addEventListener("input", draw));
    root.querySelectorAll<HTMLButtonElement>("[data-rgb-preset]").forEach((button) => button.addEventListener("click", () => {
      const values = button.dataset.rgbPreset?.split(",") ?? [];
      inputs.forEach((input, index) => { if (values[index] !== undefined) input.value = values[index]; });
      draw();
    }));
    root.querySelector<HTMLButtonElement>("[data-copy-hex]")?.addEventListener("click", async () => {
      const hex = hexOutput?.textContent ?? "";
      if (!hex || !status) return;
      try { await navigator.clipboard.writeText(hex); status.textContent = `${hex} zkopírováno.`; }
      catch { status.textContent = "Kopírování není v tomto prohlížeči dostupné. Hodnotu můžeš označit a zkopírovat ručně."; }
    });
    draw();
  });
</script>
