---
import { withBase } from "../../lib/paths";
import { getCollection } from "astro:content";
import ListingPage from "../../components/content/ListingPage.astro";
import { publicEntries, toCardItem } from "../../lib/content";
const entries = publicEntries(await getCollection("experiments"));
const items = entries.map((entry) => toCardItem(entry, "experiments"));
---
<ListingPage title="IT laboratoř" description="Technologie nejsou jen teorie. Měň vstupní hodnoty, pozoruj výsledek a zkus vysvětlit, proč se změnil. Experimenty běží přímo v prohlížeči." eyebrow="Experimentuj" items={items} action={withBase("/laborator/")} />
