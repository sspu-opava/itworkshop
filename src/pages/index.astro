---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import ContentCard from "../components/content/ContentCard.astro";
import Icon from "../components/Icon.astro";
import SectionHeading from "../components/content/SectionHeading.astro";
import TopicCard from "../components/content/TopicCard.astro";
import { topics } from "../data/topics";
import { publicEntries, sortCourses, toCardItem } from "../lib/content";

const [courseEntries, articleEntries, quizEntries, challengeEntries, linkEntries] = await Promise.all([
  getCollection("courses"), getCollection("articles"), getCollection("quizzes"), getCollection("challenges"), getCollection("links"),
]);
const courses = sortCourses(publicEntries(courseEntries).filter((entry) => entry.data.featured)).map((entry) => toCardItem(entry, "courses")).slice(0, 3);
const articles = publicEntries(articleEntries).sort((a, b) => b.data.updatedAt.localeCompare(a.data.updatedAt)).slice(0, 2).map((entry) => toCardItem(entry, "articles"));
const publicLinks = publicEntries(linkEntries);
const homeLinks = ["python", "mdn", "cs-unplugged"].map((id) => publicLinks.find((entry) => entry.id === id)).filter((entry) => entry !== undefined);
const quizCard = publicEntries(quizEntries).find((entry) => entry.id === "it-kviz");
const challengeEntry = publicEntries(challengeEntries)[0];
const quiz = quizCard ? toCardItem(quizCard, "quizzes") : undefined;
const challenge = challengeEntry ? {
  ...toCardItem(challengeEntry, "challenges"),
  title: "Programátorské výzvy",
  description: "Tři úlohy, u kterých se hodí rozdělit problém na malé kroky.",
  href: "/vyzvy/",
  type: "Výzvy",
} : undefined;
---

<BaseLayout title="Tvůj vstup do světa IT" description="Objevuj programování, tvoř weby, poznávej AI a zkoušej informatiku na vlastní kůži. Bez účtu a bez předchozích zkušeností.">
  <section class="hero wrap" aria-labelledby="hero-title">
    <div class="hero-copy">
      <p class="eyebrow"><span class="eyebrow-dot" aria-hidden="true"></span>IT, které si můžeš vyzkoušet</p>
      <h1 id="hero-title">Tvůj vstup do světa <span>IT</span></h1>
      <p class="hero-lead">Objevuj programování, tvoř weby, poznávej umělou inteligenci a zkoušej grafiku. Začni tím, co tě zajímá — bez předchozích zkušeností.</p>
      <div class="button-row">
        <a class="button button-primary" href="/kurzy/">Prozkoumat kurzy</a>
        <a class="button button-secondary" href="/kvizy/it-kviz/">Zkusit kvíz</a>
      </div>
      <ul class="hero-points" aria-label="Jak portál funguje">
        <li><span class="check-mark" aria-hidden="true">✓</span> Bez účtu</li>
        <li><span class="check-mark" aria-hidden="true">✓</span> Vlastním tempem</li>
      </ul>
    </div>
    <figure class="hero-visual">
      <img src="/images/hero-learning.webp" alt="Dva studenti společně zkoumají programovací příklad na notebooku ve světlé školní učebně" width="1536" height="1024" fetchpriority="high" />
      <figcaption><span class="hero-visual-label"><Icon name="code" size={18} /> Učení začíná otázkou</span></figcaption>
    </figure>
  </section>

  <section class="wrap topics-section" aria-labelledby="topics-title">
    <SectionHeading id="topics-title" eyebrow="Vyber si směr" title="Co tě zajímá?" linkHref="/temata/" linkLabel="Všechna témata" />
    <div class="topic-grid">
      {topics.map((topic) => <TopicCard topic={topic} />)}
    </div>
  </section>

  <section class="content-band" aria-labelledby="courses-title">
    <div class="wrap">
      <SectionHeading id="courses-title" eyebrow="Začni objevovat" title="Doporučené kurzy" linkHref="/kurzy/" linkLabel="Prohlédnout kurzy" />
      <div class="card-grid card-grid-three">
        {courses.map((course) => <ContentCard item={course} />)}
      </div>
    </div>
  </section>

  <section class="wrap discovery-section" aria-labelledby="discover-title">
    <div class="discovery-main">
      <SectionHeading id="discover-title" eyebrow="Zkus si to nanečisto" title="Znalosti rostou praxí" description="Krátký kvíz ti hned vysvětlí odpověď. Výzvu můžeš řešit po svém a nápovědu otevřít až ve chvíli, kdy ji potřebuješ." />
      <div class="card-grid card-grid-two">
        {quiz && <ContentCard item={{ ...quiz, icon: "trophy" }} />}
        {challenge && <ContentCard item={challenge} />}
      </div>
    </div>
    <aside class="discovery-aside" aria-labelledby="lab-title">
      <div class="aside-icon"><Icon name="flask" size={24} /></div>
      <div>
        <p class="eyebrow">Interaktivní experimenty</p>
        <h2 id="lab-title">IT laboratoř</h2>
        <p>Měň hodnoty, sleduj výsledky a zkoušej vlastní postupy. Vše běží přímo v prohlížeči.</p>
        <a class="text-link" href="/laborator/">Otevřít laboratoř</a>
      </div>
      <div class="lab-decoration" aria-hidden="true"><span>1010</span><span>#00CCFF</span><span>RGB</span></div>
    </aside>
  </section>

  <section class="wrap workshop-band" aria-labelledby="workshop-title">
    <div class="workshop-copy">
      <span class="workshop-icon"><Icon name="graduation" size={28} /></span>
      <div>
        <p class="eyebrow">Pro žáky a školy</p>
        <h2 id="workshop-title">Workshopy pro ZŠ</h2>
        <p>Praktické setkání, kde si vyzkoušíš programování a vytvoříš vlastní řešení. Termíny zveřejníme po potvrzení organizace.</p>
        <a class="button button-outline" href="/workshopy/">Zjistit více</a>
      </div>
    </div>
    <div class="workshop-art" aria-hidden="true"><div class="workshop-window"><span></span><span></span><span></span><i>&lt;/&gt;</i></div><div class="workshop-orbit"></div></div>
  </section>

  <section class="wrap articles-section" aria-labelledby="articles-title">
    <SectionHeading id="articles-title" eyebrow="Čti a pokračuj" title="Tipy k objevování" linkHref="/clanky/" linkLabel="Všechny články" />
    <div class="card-grid card-grid-two articles-grid">
      {articles.map((article) => <ContentCard item={article} />)}
    </div>
  </section>

  <section class="content-band home-resources" aria-labelledby="resources-title">
    <div class="wrap">
      <SectionHeading id="resources-title" eyebrow="Objevuj dál" title="Vybrané zdroje na internetu" linkHref="/odkazy/" linkLabel="Všechny zdroje" />
      <div class="resource-preview-grid">
        {homeLinks.map((resource) => <article class="resource-preview"><p class="eyebrow">{resource.data.provider} · {resource.data.language}</p><h3><a href={resource.data.url} target="_blank" rel="noopener noreferrer">{resource.data.title}<span class="sr-only"> (otevře novou kartu)</span></a></h3><p>{resource.data.description}</p></article>)}
      </div>
    </div>
  </section>
</BaseLayout>
