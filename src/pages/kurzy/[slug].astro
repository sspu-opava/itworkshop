---
import { getCollection, render } from "astro:content";
import ContentLayout from "../../layouts/ContentLayout.astro";
import Icon from "../../components/Icon.astro";
import { withBase } from "../../lib/paths";
import LiaScriptLaunch from "../../components/interactive/LiaScriptLaunch.astro";
import { allCardItems, difficultyLabels, publicEntries, relatedContent, toCardItem, topicLabels } from "../../lib/content";

export async function getStaticPaths() {
  const [courses, items] = await Promise.all([getCollection("courses"), allCardItems()]);
  return publicEntries(courses).map((entry) => ({ params: { slug: entry.id }, props: { entry, relatedItems: relatedContent(items, toCardItem(entry, "courses")) } }));
}
const { entry, relatedItems } = Astro.props;
const { Content } = await render(entry);
const d = entry.data;
const additionalLinks = entry.id === "tvorba-vlastniho-webu"
  ? [
      { href: "/courses/web/index.html", label: "Stáhnout ukázkové HTML", download: true },
      { href: "/courses/web/styles.css", label: "Stáhnout ukázkové CSS", download: true },
    ]
  : entry.id === "vyzkousej-si-python"
    ? [{ href: "/navody/prvni-program-v-pythonu/", label: "Spustit Python místně" }]
    : [];
---
<ContentLayout title={d.title} description={d.description} kind="Kurz" topic={topicLabels[d.topic]} difficulty={difficultyLabels[d.difficulty]} duration={d.durationMinutes} age={d.ageMin} breadcrumbs={[{ label: "Domů", href: "/" }, { label: "Kurzy", href: "/kurzy/" }, { label: d.title }]} relatedItems={relatedItems}>
  {d.cover && <figure class="course-detail-banner"><img src={withBase(d.cover)} alt={d.coverAlt ?? ""} width="1376" height="768" fetchpriority="high" /></figure>}
  <Content />
  <section class="course-panel" aria-labelledby="course-objectives">
    <h2 id="course-objectives">Co si vyzkoušíš</h2>
    <ul>{d.objectives.map((objective) => <li>{objective}</li>)}</ul>
    <h3>Co potřebuješ</h3>
    <ul>{d.prerequisites.map((item) => <li>{item}</li>)}</ul>
  </section>
  <section class="course-lessons" aria-labelledby="course-lessons-title">
    <h2 id="course-lessons-title">Lekce</h2>
    <ol>{d.lessons.map((lesson) => <li><strong>{lesson.title}</strong><span>{lesson.description}</span></li>)}</ol>
  </section>
  {d.coursePath && <LiaScriptLaunch path={d.coursePath} title="Otevři interaktivní kurz" description="Kurz v LiaScriptu propojuje vysvětlení, ukázky a úkoly. Při potížích můžeš stáhnout zdroj a pokračovat ve vlastním editoru." additionalLinks={additionalLinks} />}
  {entry.id === "objevujeme-ai" && <section class="offline-activity"><h2>Offline experiment: roztřiď předměty</h2><p>Vymysli pravidlo podle hmotnosti a materiálu a roztřiď šest fiktivních předmětů. Pak změň pravidlo a najdi hraniční případy. Tento ruční klasifikátor je jen pravidlo, ne natrénovaná neuronová síť.</p><ul><li>Papírová kulička: lehká, papír.</li><li>Kovová sponka: lehká, kov.</li><li>Dřevěná kostka: těžší, dřevo.</li><li>Plastový dílek: lehký, plast.</li><li>Kovová matice: těžší, kov.</li><li>Papírová kartička: lehká, papír.</li></ul></section>}
  <aside slot="aside" class="detail-tip"><h2><Icon name="check" size={18} /> Učení bez tlaku</h2><p>Můžeš postupovat vlastním tempem a k materiálu se kdykoli vrátit. Výsledky zůstávají ve tvém zařízení.</p></aside>
</ContentLayout>
