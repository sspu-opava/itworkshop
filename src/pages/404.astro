---
import { withBase } from "../lib/paths";
import BaseLayout from "../layouts/BaseLayout.astro";
---
<BaseLayout title="Tady jsme trochu zabloudili" description="Stránka neexistuje nebo se přesunula." indexContent={false} noIndex>
  <section class="wrap not-found">
    <p class="eyebrow">Chyba 404</p>
    <h1>Tady jsme trochu zabloudili</h1>
    <p>Stránka neexistuje nebo se přesunula. Vrať se na úvodní stránku, prozkoumej témata nebo zkus vyhledávání.</p>
    <div class="button-row"><a class="button button-primary" href={withBase("/")}>Zpět na úvod</a><a class="button button-secondary" href={withBase("/temata/")}>Prozkoumat témata</a><a class="text-link" href={withBase("/vyhledavani/")}>Vyhledávání</a></div>
  </section>
</BaseLayout>
