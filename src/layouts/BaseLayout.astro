---
import { withBase } from "../lib/paths";
import "../styles/global.css";
import SiteHeader from "../components/layout/SiteHeader.astro";
import SiteFooter from "../components/layout/SiteFooter.astro";
interface Props {
  title: string;
  description: string;
  canonical?: string;
  indexContent?: boolean;
  noIndex?: boolean;
}
const { title, description, canonical, indexContent = true, noIndex = false } = Astro.props;
const canonicalUrl = canonical ?? (Astro.site ? new URL(Astro.url.pathname, Astro.site).href : Astro.url.href);
const pageTitle = title.includes("ITWORKSHOP") ? title : `${title} | ITWORKSHOP`;
---
<!doctype html>
<html lang="cs">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#003399" />
    {noIndex && <meta name="robots" content="noindex, nofollow" />}
    {!noIndex && <link rel="canonical" href={canonicalUrl} />}
    <link rel="icon" href={withBase("/favicon.svg")} type="image/svg+xml" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="cs_CZ" />
    <meta property="og:site_name" content="ITWORKSHOP" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={new URL(withBase("/images/hero-learning.webp"), Astro.site).href} />
    <meta name="twitter:card" content="summary_large_image" />
    <title>{pageTitle}</title>
  </head>
  <body>
    <SiteHeader />
    <main id="main-content" data-pagefind-body={indexContent ? "" : undefined}>
      <slot />
    </main>
    <SiteFooter />
  </body>
</html>
