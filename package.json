    "test:e2e:preview": "node scripts/test-preview.mjs",
    "check:links": "node scripts/check-links.mjs"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@astrojs/markdown-satteri": "0.4.10",
    "@astrojs/mdx": "8.1.6",
    "@astrojs/sitemap": "3.7.6",
    "@playwright/test": "1.65.1",
    "@tailwindcss/vite": "4.3.5",
    "astro": "7.4.13",
    "pagefind": "1.6.0",
    "tailwindcss": "4.3.5",
    "typescript": "6.0.3",
    "vitest": "5.1.2"
  }
}
